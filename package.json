{
  "name": "designhub",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first DesignHub desktop shell.",
  "packageManager": "pnpm@10.23.0",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "vite build --config vite.config.ts && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "test:unit": "vitest run --config vitest.config.ts src",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:native": "playwright test --config playwright.native.config.ts",
    "lint": "eslint src tests *.config.ts *.config.mjs forge.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.0.0",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.2",
    "konva": "10.5.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.7",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electron": "44.3.0",
    "eslint": "9.39.2",
    "jsdom": "27.4.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
